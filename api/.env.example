# Copy this file to .env and edit before the demonstration.

# Signs the session cookie. Use a long random value on the server.
MYTURN_SECRET=change-me-to-a-long-random-string

# The shared password the dashboard accepts during the classroom demonstration.
MYTURN_STAFF_PASSWORD=myturn

# The first administrator, created by `python seed_admin.py`. The application
# itself never reads MYTURN_ADMIN_PASSWORD: only that command does, so no
# administrator password is ever written into the code.
MYTURN_ADMIN_EMAIL=admin@myturn.local
MYTURN_ADMIN_PASSWORD=choose-a-long-one-before-the-defence
MYTURN_ADMIN_NAME=MyTurn administrator

# Account rules.
MYTURN_PASSWORD_MIN_LENGTH=8
MYTURN_INVITATION_TTL_HOURS=72
MYTURN_RESET_TTL_MINUTES=30
MYTURN_LOGIN_ATTEMPTS=8
MYTURN_LOGIN_WINDOW_SECONDS=300
MYTURN_RESET_ATTEMPTS=5
MYTURN_RESET_WINDOW_SECONDS=900

# There is no mail server in the prototype, so a password-reset link is returned
# in the response and written to the log. Never turn this on for a real service.
MYTURN_DEV_TOKENS=1

# How long a called ticket keeps its place, in seconds.
MYTURN_HOLD_SECONDS=60
# The board may shorten that hold to this when the counter is verifiably empty,
# but never before this many seconds have passed. Both fall back to the full
# hold when the board is offline or has not reported since the call.
MYTURN_MIN_CALL_SECONDS=25
MYTURN_MIN_GRACE_SECONDS=10

# The first service of the office, used for the first run only. After that the
# name, description and target time are edited in the console and stored in
# the services table, so a change does not need a restart. The other services
# and every desk are added in the console too.
MYTURN_DESK_NAME=General Service
MYTURN_DESK_DESCRIPTION=All enquiries handled at the front desk.

# Tickets one address may take in a minute, so a reload loop cannot fill the
# queue. And how many served tickets are needed before the page offers an
# estimate of the wait; below that it says the estimate is not available.
MYTURN_TICKET_ATTEMPTS=20
MYTURN_TICKET_WINDOW_SECONDS=60
MYTURN_ETA_MIN_SAMPLES=3

# How long an approach report still counts, and when a board is shown offline.
MYTURN_APPROACH_WINDOW_SECONDS=10
MYTURN_DEVICE_ONLINE_SECONDS=30

# Set to 1 only when the site is served over HTTPS.
MYTURN_SECURE_COOKIES=0

# Where the web app runs during development.
MYTURN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Which interface the API binds to.
#   127.0.0.1  loopback only - the laptop, the browser and the web app, but NOT
#              the ESP32 board, which reaches the API over the network.
#   0.0.0.0    every interface - required for the board to report.
# Set this to 0.0.0.0 whenever the physical board is in use. On the Windows
# mobile hotspot the laptop is 192.168.137.1 and the board joins as
# 192.168.137.x, so the board's API_BASE points at 192.168.137.1:5000.
MYTURN_HOST=0.0.0.0

# Optional: move the database somewhere else.
# MYTURN_DB=C:\myturn\data\myturn.db

# SMS notifications via openSMS.dev (https://opensms.io). Optional: when the
# key is empty the desk still shows the visitor's contact as a clickable link,
# but no automatic text is sent. Create an API key in the openSMS dashboard and
# paste it here. The gateway runs on an Android phone with a SIM.
MYTURN_OPENSMS_API_KEY=opensms_Mult7ppEFwgM4QUoVKYuF01u2sC-ShGj
MYTURN_OPENSMS_API_URL=https://opensms.io
MYTURN_OPENSMS_COUNTRY_CODE=250
