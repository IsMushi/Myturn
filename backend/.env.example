# Copy this file to .env and edit before the demonstration.

# Signs the staff session cookie. Use a long random value on the server.
MYTURN_SECRET=change-me-to-a-long-random-string

# The password staff use on the dashboard.
MYTURN_STAFF_PASSWORD=myturn

# How long a called ticket keeps its place, in seconds.
MYTURN_HOLD_SECONDS=60

# How long an approach report still counts, and when a board is shown offline.
MYTURN_APPROACH_WINDOW_SECONDS=10
MYTURN_DEVICE_ONLINE_SECONDS=30

# Set to 1 only when the site is served over HTTPS.
MYTURN_SECURE_COOKIES=0

# Where the frontend runs during development.
MYTURN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: move the database somewhere else.
# MYTURN_DB=C:\myturn\data\myturn.db
